# AEGIS OMEGA SHIELD - deployment configuration for deploy/docker-compose.yml
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Every value marked REQUIRED must be set before `docker compose up`. Generate secrets with
#   openssl rand -hex 32
# Use hex/alphanumeric secrets: POSTGRES_PASSWORD is embedded in a database URL.
# Never commit deploy/.env (it is git- and docker-ignored).

# ---------------------------------------------------------------------------- image
# Image built by `docker compose build` or pulled from your registry (pin a digest in production,
# e.g. ghcr.io/<org>/aegis-omega@sha256:...).
AEGIS_IMAGE=aegis-omega:1.0.0

# ---------------------------------------------------------------------------- network
# Address the console/API port is published on. Keep 127.0.0.1 and put the operator's TLS
# reverse proxy / load balancer in front (docs/INSTALL.md). 0.0.0.0 only behind a firewall.
AEGIS_BIND=127.0.0.1
AEGIS_PORT=8000
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (comma separated).
AEGIS_FORWARDED_ALLOW_IPS=127.0.0.1
# Browser origins allowed to call the API cross-origin (normally empty: the console is same-origin).
AEGIS_CORS_ORIGINS=

# ---------------------------------------------------------------------------- runtime mode
# production enforces: OIDC only, explicit pseudonymization key, no demo tenant.
AEGIS_ENV=production
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=json

# ---------------------------------------------------------------------------- database (REQUIRED)
POSTGRES_DB=aegis
POSTGRES_USER=aegis
# REQUIRED: openssl rand -hex 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------- authentication
# OIDC (RS256/PS256/ES256 via JWKS). Tokens must carry the tenant and roles claims below.
# Roles: viewer, analyst, approver, admin, integration (see docs/INSTALL.md "Identity provider").
AEGIS_AUTH_MODE=oidc
# REQUIRED: issuer URL exactly as in the token's `iss` claim, e.g. https://sso.operator.example/realms/soc
AEGIS_OIDC_ISSUER=
# REQUIRED: audience the IdP puts in `aud` for this API, e.g. aegis-api
AEGIS_OIDC_AUDIENCE=aegis-api
# Optional: discovered from the issuer's /.well-known/openid-configuration when empty.
AEGIS_OIDC_JWKS_URL=
AEGIS_OIDC_TENANT_CLAIM=tenant_id
AEGIS_OIDC_ROLES_CLAIM=roles
AEGIS_OIDC_ALGORITHMS=RS256
AEGIS_JWT_LEEWAY_S=60
AEGIS_JWKS_CACHE_TTL_S=3600

# ---------------------------------------------------------------------------- privacy (REQUIRED)
# Master key from which per-tenant HMAC pseudonymization keys are derived (hex, >= 16 bytes;
# use 32). Losing it breaks pseudonym continuity; rotating it is a planned operation
# (docs/runbooks/key-rotation.md). Store a copy in the operator's secrets vault.
AEGIS_PSEUDONYM_MASTER_KEY=

# ---------------------------------------------------------------------------- monitoring (REQUIRED)
# Bearer token Prometheus must present on /metrics: openssl rand -hex 32
AEGIS_METRICS_TOKEN=
# Grafana (monitoring profile only, but compose validates it for every profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# true when Grafana is served over HTTPS by your reverse proxy
GRAFANA_COOKIE_SECURE=false
MONITORING_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=30d

# ---------------------------------------------------------------------------- provenance
# Id of the ledger signing key (generated in the data volume). A new id rotates the key:
# docs/runbooks/key-rotation.md
AEGIS_LEDGER_KEY_ID=aegis-ledger

# ---------------------------------------------------------------------------- detection model
# Require a valid Ed25519 signature (by a trusted ledger key) on the model artifact.
AEGIS_MODEL_REQUIRE_SIGNATURE=false

# ---------------------------------------------------------------------------- enforcement
# Shadow pilots keep dryrun: nothing is ever sent to the network. Active enforcement additionally
# requires a signed operator policy with mode=active and a legal sign-off reference, and every
# action still goes through MIRROR simulation, authorization and four-eyes approval.
AEGIS_ENFORCEMENT_ADAPTER=dryrun
# rpz adapter: zone file path inside the container (mount a volume) and optional reload command
AEGIS_RPZ_ZONE_PATH=
AEGIS_RPZ_RELOAD_COMMAND=
# webhook adapter: operator endpoint and HMAC secret
AEGIS_WEBHOOK_URL=
AEGIS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------- optional LLM assistance
# The whole detection path works without an LLM. When enabled, ORACLE sends pseudonymized case
# summaries to the configured provider: record it as a processor in the DPIA before enabling.
AEGIS_LLM_ENABLED=false
ANTHROPIC_API_KEY=
# Model id; empty = the configured default model.
AEGIS_LLM_MODEL=

# ---------------------------------------------------------------------------- HTTP limits
AEGIS_RATE_LIMIT_RPS=20
AEGIS_RATE_LIMIT_BURST=200
# Maximum ingest request body (bytes); split larger collector files.
AEGIS_MAX_INGEST_BYTES=67108864
AEGIS_MAX_PAGE_SIZE=500

# ---------------------------------------------------------------------------- ingest bus
AEGIS_BUS_MAX_QUEUE=2000000
# Per-tenant in-flight event quota (empty = no per-tenant quota)
AEGIS_BUS_PER_TENANT_QUOTA=
# Seconds between sweeps that expire and roll back time-boxed actions
AEGIS_SWEEP_INTERVAL_S=60

# ---------------------------------------------------------------------------- optional bus profile
REDPANDA_ADVERTISE_HOST=localhost
BUS_BIND=127.0.0.1
