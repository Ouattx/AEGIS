# AEGIS home lab configuration. Copy to homelab.env (same directory) and edit.
# Every script in deploy/homelab reads this file. Values below are the defaults.

# --- Wi-Fi access point (the isolated lab network the device under test joins) ---
LAB_IFACE=wlan0                 # Wi-Fi interface that becomes the lab access point
UPLINK_IFACE=eth0               # interface that reaches the internet (your home router)
LAB_SSID=aegis-lab
LAB_PASSPHRASE=                 # REQUIRED: 12+ characters, used only for this lab network
COUNTRY_CODE=FR                 # regulatory domain of your country (FR, DE, BE, ...)
WIFI_CHANNEL=6

# --- Addressing (keep it different from your home LAN) ---
LAB_GATEWAY=10.42.0.1
LAB_PREFIX_LEN=24
LAB_SUBNET=10.42.0.0/24
DHCP_START=10.42.0.20
DHCP_END=10.42.0.60
UPSTREAM_DNS="9.9.9.9 149.112.112.112"   # resolvers dnsmasq forwards to

# --- Safety limits ---
# Upload and download rate cap for the lab (kbytes/second). Empty = no cap.
# A cap limits the damage if the device is used as a proxy or for attacks from your connection.
EGRESS_RATE_KBYTES=500
# Block DNS-over-TLS (port 853) so the device falls back to the logged lab resolver (1 = block).
BLOCK_DOT=0

# --- Capture (headers only) ---
CAPTURE_ROOT=/var/lib/aegis-homelab
SNAPLEN=96                      # bytes kept per packet: Ethernet + IP + TCP/UDP headers, no content
ROTATE_SECONDS=3600             # one pcap file per hour
MAX_HOURS=72                    # hard time limit: capture stops after this many hours
